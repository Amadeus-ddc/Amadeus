# OpenAI-compatible API endpoint for the main model, e.g. local vLLM.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=token-abc123

# Optional: separate judge endpoint for LoCoMo evaluation.
# If unset, LoCoMo falls back to OPENAI_BASE_URL / OPENAI_API_KEY.
JUDGE_API_BASE=
JUDGE_API_KEY=

# Optional local data paths. These are ignored by git and should point to files on your machine.
LOCOMO_DATA_FILE=dataset/LoCoMo/locomo10.json
ALFWORLD_DATA=dataset/ALFWorld
ALFWORLD_TRAJ_FILE=dataset/ALFWorld/alfworld_format_traj.json

# ALFWorld environment wrapper (bundled in experiments/verl-agent/).
# Override only if you use a different verl-agent checkout.
# VERL_AGENT_ROOT=experiments/verl-agent

# Offline execution hints.
HF_HOME=data/hf_cache
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
